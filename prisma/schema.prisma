// MailPulse - Bulk Email Sender schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model EmailSession {
  id            String   @id @default(cuid())
  name          String
  color         String   @default("#3b82f6") // hex color for campaign identification
  status        String   @default("draft") // draft | queued | running | paused | completed | failed | cancelled
  totalEmails   Int      @default(0)
  sentCount     Int      @default(0)
  failedCount   Int      @default(0)
  pendingCount  Int      @default(0)
  deletedAt     DateTime? // soft delete — moved to trash when set

  // Sender
  fromName      String
  fromEmail     String

  // Provider
  providerType  String   // gmail | yahoo | smtp
  smtpHost      String?
  smtpPort      Int?
  smtpSecure    Boolean?

  // Email content
  subject       String
  bodyHtml      String
  plainText     String?

  // Signature
  signatureText String?
  signatureImage String? // base64 data URL or path

  // Sending config
  batchSize     Int      @default(10)
  batchDelayMs  Int      @default(2000)
  perEmailDelayMs Int    @default(500)

  // Stats
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipients    EmailRecipient[]
  attachments   Attachment[]
  logs          SendLog[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model EmailRecipient {
  id            String   @id @default(cuid())
  sessionId     String
  email         String
  name          String
  status        String   @default("pending") // pending | sending | sent | failed
  error         String?
  attemptCount  Int      @default(0)
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       EmailSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, status])
}

model Attachment {
  id            String   @id @default(cuid())
  sessionId     String
  filename      String
  filepath      String
  mimetype      String
  size          Int
  createdAt     DateTime @default(now())

  session       EmailSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Signature {
  id            String   @id @default(cuid())
  name          String
  type          String   // text | image
  content       String   // text content or base64 data URL
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model EmailTemplate {
  id            String   @id @default(cuid())
  name          String
  subject       String
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

model SendLog {
  id            String   @id @default(cuid())
  sessionId     String
  level         String   // info | success | warn | error
  message       String
  recipient     String?
  createdAt     DateTime @default(now())

  session       EmailSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

// Key/value store for remembered preferences (last provider, throttle preset,
// default profile id, …). Lets the wizard start already configured next time.
model Setting {
  key       String   @id
  value     String // JSON payload
  updatedAt DateTime @updatedAt
}

// Saved SMTP identity with the app password encrypted at rest (AES-256-GCM).
// Passwords are only ever decrypted server-side at send time when launched with
// the "send with saved password" option.
model SmtpProfile {
  id           String   @id @default(cuid())
  name         String // human label, e.g. "Work — jane@gmail.com"
  providerType String
  fromName     String
  fromEmail    String
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean  @default(false)
  smtpUser     String
  smtpPassEnc  String // encrypted app password
  isDefault    Boolean  @default(false)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([smtpUser])
  @@index([lastUsedAt])
}

// Auto-saved snapshot of the wizard (every field except the SMTP password).
// Survives browser refreshes, dev-server restarts and full power failures so
// the user can resume instead of starting from scratch.
model WizardDraft {
  id        String   @id @default("main")
  content   String // JSON snapshot
  updatedAt DateTime @updatedAt
}
