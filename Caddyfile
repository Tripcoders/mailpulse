# Caddy gateway — single entry point on :8088
#   /engine/socket/…  → send-engine socket.io (websocket reverse proxy)
#   /*                → Next.js web app
# Same-origin socket path also makes tunnels/LAN/proxies work unchanged.

:8088 {
	encode gzip

	handle_path /engine/socket* {
		reverse_proxy engine:3003
	}

	handle {
		reverse_proxy web:3000
	}
}
