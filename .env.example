# Neon PostgreSQL application connection (use the pooled endpoint).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon PostgreSQL direct endpoint for schema migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon Auth project endpoint and server-side cookie signing secret (32+ characters).
NEON_AUTH_BASE_URL=https://example-neon-auth-endpoint
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
NEON_INITIAL_OWNER_EMAIL=owner@example.com

# Stable key for encrypting saved SMTP profile passwords on the web app.
SECRET_KEY=replace-with-at-least-32-random-characters

# Local or self-hosted sender worker only. Vercel campaign delivery uses
# Vercel Queues and does not require a sender URL or ENGINE_API_TOKEN.
ENGINE_API_TOKEN=replace-with-a-long-random-shared-token
ENGINE_URL=http://localhost:3003
ENGINE_CONTROL_URL=http://localhost:3003
NEXT_PUBLIC_ENGINE_URL=http://localhost:3003
APP_ORIGIN=http://localhost:3000
